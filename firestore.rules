rules_version = '2';
// Eco Kassa — Firestore xavfsizlik qoidalari (2-bosqich: xodim ruxsatlari bazada ham tekshiriladi).
// Kim kirganini Telegram bot (server) tasdiqlaydi va /sessions/{qurilma} yozuviga yozadi.
// Sotish hamma ulangan qurilmalar uchun doim ochiq — bot ishlamasa ham savdo to'xtamaydi.
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- Yordamchi funksiyalar ----------
    function isDevice() {
      return request.auth != null
        && exists(/databases/$(db)/documents/devices/$(request.auth.uid));
    }
    function hasSess() {
      return request.auth != null
        && exists(/databases/$(db)/documents/sessions/$(request.auth.uid));
    }
    function sess() {
      return get(/databases/$(db)/documents/sessions/$(request.auth.uid)).data;
    }
    function liveSess() {
      return hasSess() && sess().get('exp', 0) > request.time.toMillis();
    }
    function isOwner() {
      return isDevice() && liveSess() && sess().get('role', 'none') == 'owner';
    }
    function can(p) {
      return isOwner()
        || (isDevice() && liveSess() && sess().get('role', 'none') == 'seller'
            && sess().get('perms', {}).get(p, false) == true);
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function onlyChanged(keys) {
      return changed().hasOnly(keys);
    }
    // Qarz kamayishi / keshbek ko'payishi uchun "dalil" hujjat (to'lov, qaytarish yoki chek).
    // Mijoz yozuvida lastRefCol, lastRefId, lastRefTs bo'ladi — ular shu hujjatni ko'rsatadi.
    function nd() { return request.resource.data; }
    function refFresh() {
      return nd().get('lastRefTs', 0) is number
        && nd().get('lastRefId', '') is string && nd().get('lastRefId', '') != ''
        && nd().lastRefId != resource.data.get('lastRefId', '')
        && nd().lastRefTs >= resource.data.get('lastRefTs', 0) - 600000;
    }
    function refDoc(col) {
      return get(/databases/$(db)/documents/$(col)/$(nd().lastRefId)).data;
    }
    function debtDownOk(cid, amt) {
      return refFresh() && (
        (nd().get('lastRefCol', '') == 'payments'
          && refDoc('payments').get('refId', '') == cid
          && refDoc('payments').get('kind', '') == 'client'
          && refDoc('payments').get('amount', 0) >= amt)
        || (nd().get('lastRefCol', '') == 'returns'
          && refDoc('returns').get('clientId', '') == cid
          && refDoc('returns').get('debtOff', 0) >= amt));
    }
    function cbUpOk(cid, amt) {
      return refFresh() && nd().get('lastRefCol', '') == 'sales'
        && refDoc('sales').get('clientId', '') == cid
        && refDoc('sales').get('cbEarned', 0) >= amt;
    }
    function clientMoneyOk(cid) {
      return (nd().get('debt', 0) >= resource.data.get('debt', 0)
              || debtDownOk(cid, resource.data.get('debt', 0) - nd().get('debt', 0)))
        && (nd().get('cashback', 0) <= resource.data.get('cashback', 0)
              || cbUpOk(cid, nd().get('cashback', 0) - resource.data.get('cashback', 0)));
    }

    // ---------- O'zgarmagan bloklar (oldingi qoidalardan) ----------
    // Rahbar parolining xeshi: hech kim o'qiy olmaydi.
    match /secret/{d} {
      allow read: if false;
      allow create: if request.auth != null && d == 'owner'
        && !exists(/databases/$(db)/documents/secret/owner);
      // Qurilma ulash parolini faqat rahbar almashtiradi.
      allow update: if d == 'owner' && (isOwner()
        || (request.auth != null && resource.data.get('reset', false) == true && !('reset' in request.resource.data)));
      allow delete: if false;
    }
    // Qurilma faqat rahbar paroli bilan ulanadi.
    match /devices/{uid} {
      allow read: if false;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.pinHash == get(/databases/$(db)/documents/secret/owner).data.pinHash;
      allow update, delete: if false;
    }
    // Telegram do'kon katalogi: hamma o'qiydi, kassa qurilmalari yangilaydi.
    match /catalog/{id} {
      allow read: if true;
      allow create, update: if isDevice();
      allow delete: if false;
    }
    // Telegram buyurtmalar: mijoz faqat yangi buyurtma qo'shadi; kassa holatini o'zgartiradi.
    match /orders/{id} {
      allow read, update: if isDevice();
      allow create: if isDevice() || (request.auth != null
        && request.resource.data.keys().hasOnly(['ts','status','src','name','phone','delivery','address','comment','items','total','tgId','tgUser','initData'])
        && request.resource.data.status == 'new'
        && request.resource.data.ts is number
        && request.resource.data.total is number && request.resource.data.total >= 0 && request.resource.data.total < 1000000000
        && request.resource.data.delivery in ['delivery', 'pickup']
        && request.resource.data.get('initData', '') is string && request.resource.data.get('initData', '').size() <= 4096
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.address is string && request.resource.data.address.size() <= 200
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 300
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50);
      allow delete: if false;
    }

    // ---------- Sessiya (kim kirgani) ----------
    // Qurilma o'z sessiyasini faqat "none" ga tushira oladi (chiqish). Ko'tarishni faqat bot qiladi.
    match /sessions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == 'none';
      allow delete: if false;
    }
    // Kirish so'rovi: faqat bot o'qiydi.
    match /sessReq/{uid} {
      allow read: if false;
      allow create, update: if isDevice() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['staffId','pw','ts']);
      allow delete: if false;
    }

    // ---------- Sozlamalar ----------
    match /meta/{d} {
      allow read: if isDevice();
      // Faqat birinchi sozlashda "settings" yaratiladi; boshqa meta yozuvlarini bot yozadi.
      allow create: if isDevice() && d == 'settings';
      allow update: if isOwner();
      allow delete: if false;
    }

    // ---------- Tovarlar ----------
    match /products/{id} {
      allow read: if isDevice();
      allow create: if isDevice() && can('addProd')
        && (request.resource.data.get('qty', 0) == 0 || can('editStock'));
      allow update: if isDevice() && (
        // sotuv: faqat qoldiq kamayadi
        (onlyChanged(['qty']) && request.resource.data.qty <= resource.data.qty)
        // qaytarish: qoldiq ko'payadi
        || (onlyChanged(['qty']) && can('ret'))
        // kirim: qoldiq, tannarx, yetkazib beruvchi, muddat
        || (onlyChanged(['qty','cost','sup','expiries']) && can('intake'))
        // tahrirlash: qoldiqqa tegmasa editProd, tegsa editStock ham kerak
        || (can('editProd') && (!changed().hasAny(['qty']) || can('editStock')))
        || can('editStock')
      );
      allow delete: if false;
    }

    // ---------- Savdo ----------
    match /sales/{id} {
      allow read: if isDevice();
      allow create: if isDevice()
        && request.resource.data.get('cbEarned', 0) <= request.resource.data.get('total', 0);
      allow update: if can('ret') && onlyChanged(['ret','retSum','retFull']);
      allow delete: if false;
    }
    match /returns/{id} {
      allow read: if isDevice();
      allow create: if can('ret');
      allow update, delete: if false;
    }

    // ---------- Ombor ----------
    match /purchases/{id} {
      allow read: if isDevice();
      allow create: if can('intake');
      allow update, delete: if false;
    }
    match /suppliers/{id} {
      allow read: if isDevice();
      allow create, update: if can('intake') || can('suppliers');
      allow delete: if false;
    }
    match /inventory/{id} {
      allow read: if isDevice();
      allow create: if isOwner();
      allow update: if isOwner() || (can('inv') && onlyChanged(['counts']));
      allow delete: if false;
    }

    // ---------- Kassa ----------
    match /expenses/{id} {
      allow read: if isDevice();
      allow create: if can('exp');
      allow update: if isOwner();
      allow delete: if false;
    }
    match /shifts/{id} {
      allow read: if isDevice();
      allow create: if can('shift');
      allow update, delete: if false;
    }

    // ---------- Marketing ----------
    match /certs/{id} {
      allow read: if isDevice();
      allow create: if isOwner();
      allow update: if isOwner()
        || (isDevice() && onlyChanged(['balance','lastUse']) && request.resource.data.balance <= resource.data.balance);
      allow delete: if false;
    }
    match /broadcasts/{id} {
      allow read: if isDevice();
      allow create: if isOwner();
      allow update, delete: if false;
    }
    match /imgBackup/{id} {
      allow read, create, update: if isOwner();
      allow delete: if false;
    }

    // ---------- Mijozlar ----------
    // Qarzni kamaytirish faqat to'lov yoki qaytarish yozuvi bilan, keshbekni oshirish faqat chek bilan.
    // Ism, telefon, chegirma kabi ma'lumotlarni "Mijozlar" ruxsati bor xodim o'zgartiradi.
    match /clients/{id} {
      allow read: if isDevice();
      allow create: if isDevice() && (isOwner()
        || (request.resource.data.get('debt', 0) == 0 && request.resource.data.get('cashback', 0) == 0));
      allow update: if isDevice() && (isOwner() || (
        (!changed().hasAny(['name','phone','discount','note','bday','archived','created']) || can('clients'))
        && clientMoneyOk(id)));
      allow delete: if false;
    }
    // To'lovlar: faqat qo'shiladi, o'zgartirilmaydi.
    match /payments/{id} {
      allow read: if isDevice();
      allow create: if isDevice()
        && request.resource.data.get('kind', '') in ['client', 'supplier']
        && request.resource.data.get('amount', 0) is number && request.resource.data.get('amount', 0) > 0;
      allow update: if isOwner();
      allow delete: if false;
    }
    // Qoldiq o'zgarishlari tarixi va sertifikat ishlatilishi: faqat qo'shiladi, hech kim o'zgartira olmaydi.
    match /stockLog/{id} {
      allow read, create: if isDevice();
      allow update, delete: if false;
    }
    match /certUses/{id} {
      allow read, create: if isDevice();
      allow update, delete: if false;
    }
    // Rahbarga tegishli maxfiy sozlamalar (AI kaliti).
    match /private/{d} {
      allow read: if isOwner() || can('addProd') || can('editProd');
      allow write: if isOwner();
    }

    // ---------- Qolgan to'plamlar ----------
    // Yangi, nomi yuqorida yozilmagan to'plamlarga faqat rahbar yoza oladi.
    match /{col}/{id} {
      allow read: if isDevice() && !(col in ['secret','devices','sessions','sessReq','tgUsers','private','imgBackup']);
      allow create, update: if isOwner() && !(col in [
        'secret','devices','catalog','orders','sessions','sessReq','meta','products','sales','returns',
        'purchases','suppliers','inventory','expenses','shifts','certs','broadcasts','imgBackup','tgUsers',
        'clients','payments','stockLog','certUses','private']);
      allow delete: if false;
    }
  }
}
